FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
		build-essential \
		git \
		pkg-config \
		protobuf-c-compiler \
		protobuf-compiler \
		libprotobuf-c-dev \
		libprotobuf-dev \
		libnl-3-dev \
		libnl-genl-3-dev \
		libnl-route-3-dev \
		libcap-dev \
		libmount-dev \
		libssl-dev \
		libnet1-dev \
		iproute2 \
		iptables \
		nftables \
		procps \
		sudo \
		python3 \
		python3-yaml \
		python3-protobuf \
	&& rm -rf /var/lib/apt/lists/*

WORKDIR /criu
